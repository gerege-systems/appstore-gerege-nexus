      "description": "Look up authoritative legal-entity data through XYP",
      "admin_only": true
    }
  ],
  "menus": [
    {
      "id": "egov_lookups",
      "label": "Registry lookups",
      "path": "/egov",
      "icon": "landmark",
      "order": 10
    },
    {
      "id": "egov_connections",
      "label": "Connections",
      "path": "/egov/connections",
      "icon": "share-2",
      "order": 20
    },
    {
      "id": "egov_history",
      "label": "Lookup history",
      "path": "/egov/history",
      "icon": "scroll-text",
      "order": 30
    }
